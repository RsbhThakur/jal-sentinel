# JAL-SENTINEL Environment Configuration Template
# Copy this to .env for local development

# ==============================================================================
# Database & Cache
# ==============================================================================
# In production / Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/jal_sentinel
# In local development fallback: sqlite+aiosqlite:///./jal_sentinel.db
DATABASE_URL=sqlite+aiosqlite:///./jal_sentinel.db
POSTGRES_DB=jal_sentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Real-time Telemetry
# In Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Backend Configuration
# ==============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
ADMIN_TOKEN=sentinel_admin_secret_token_2026

# ==============================================================================
# Frontend Configuration
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy_MOCK_GOOGLE_MAPS_KEY_FOR_DEV

# ==============================================================================
# External APIs & Gateway Credentials
# ==============================================================================
GOOGLE_MAPS_API_KEY=AIzaSy_MOCK_GOOGLE_MAPS_KEY_FOR_DEV
IMD_API_BASE_URL=https://api.imd.gov.in
FAST2SMS_API_KEY=mock_fast2sms_key
NDMA_CAP_RSS_URL=https://sachet.ndma.gov.in/cap_feed

# ==============================================================================
# Cline Agent Runtime (@cline/sdk)
# ==============================================================================
GEMINI_API_KEY=mock_gemini_key_for_cline_sdk
CLINE_AGENT_INTERVAL_SEC=30
